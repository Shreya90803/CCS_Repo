#Cross-validation - 70% training data and 30% test data repeated 100 times 
Gam 1
```{r}
n_reps <- 100 #setting number of repetitions
results <- data.frame(rho = numeric(n_reps),    #creating an empty results df 
                       intercept = numeric(n_reps), 
                       slope = numeric(n_reps), 
                       r2 = numeric(n_reps))

for (i in 1:n_reps) {  #starting 100 reps 
  set.seed(i)   #setting seed based on repetition number to make it reproducible
  train_idx <- sample(seq_len(nrow(df_vertical)), size = 0.7 * nrow(df_vertical)) #randomly selects 70% of data
  train_data <- df_vertical[train_idx, ] #extracts the selected data into train_idx
  test_data  <- df_vertical[-train_idx, ] #extracts the unselected (30%) of data into test data
  
  gam_i <- gam(   #fit GAM on training data
    prop_cum ~ ti(perc_depth, by = Month) + s(max_depth) + ti(perc_depth, max_depth) +
      s(Temp) + s(Salinity) + s(time_of_day) + s(Light),
    family = betar(link = "logit"), method = "REML", select = TRUE,
    data = train_data
  )
  
  pred_test <- predict(gam_i, newdata = test_data, type = "response") #predict GAM on test data 
  
  results$rho[i] <- cor(test_data$prop_cum, pred_test, method = "spearman", use = "complete.obs")  #calculate Spearman's correlation
  
#fit linear regression between predicted and observed data 
  lm_fit <- lm(test_data$prop_cum ~ pred_test)   
  results$intercept[i] <- coef(lm_fit)[1]  #extract intercept
  results$slope[i]     <- coef(lm_fit)[2]  #extract slope
  results$r2[i]        <- summary(lm_fit)$r.squared  #extract r^2
}

WC_Pos_ColMeans=data.frame(colMeans(results, na.rm = TRUE))  #calculate mean of each column and put in a df
```

