    annotation_scale(location = "bl") +   #making scale bar
    annotation_north_arrow(location = "bl", style = north_arrow_fancy_orienteering(), #making north arrow
                            height = unit(0.9, "cm"), width = unit(0.9, "cm"),  
                            pad_x = unit(0.05, "cm"), pad_y = unit(0.7, "cm")) +
    labs(subtitle = month.name[selected_month], x = NULL, y = NULL) +   #Making month labels
    theme_minimal() +
    theme(plot.subtitle = element_text(size = 14, face = "bold", hjust = 0.5))  #making month labels bigger, bold and centred
