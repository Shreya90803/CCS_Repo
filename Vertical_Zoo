#Interpolating CTD data (With AI help)
```{r}
library(tidyverse)

#Identify numeric columns
numeric_cols <- CTDmergedvals |>
  select(where(is.numeric)) |>
  select(-depth) |>
  names()

#interpolation function
interp_group <- function(df) {
  nd <- seq(floor(min(df$depth)), ceiling(max(df$depth)), by = 1)
  out <- tibble(depth = nd)
  
  for (col in numeric_cols) {
    v <- df[[col]]
    m <- !is.na(v)
    if (sum(m) < 2) { out[[col]] <- NA_real_; next }
    out[[col]] <- approx(x = df$depth[m], y = v[m], xout = nd, rule = 1)$y
  }
   out$ID <- unique(df$ID)
   out$station    <- unique(df$station)
   out$cruise.name  <- unique(df$cruise.name)
   out$date_clean <- unique(df$date_clean)
  return(out)
}

CTD_Interp <- CTDmergedvals |>
  group_by(ID) |>
  group_split() |>
  lapply(interp_group) |>
  bind_rows()
```

